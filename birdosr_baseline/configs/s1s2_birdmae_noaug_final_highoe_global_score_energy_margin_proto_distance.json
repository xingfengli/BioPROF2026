{
  "experiment_name": "s1s2_birdmae_noaug_final_highoe_global_score_energy_margin_proto_distance",
  "data_root": "data/SCorpora",
  "scenario": "s1s2",
  "train_site": "S1",
  "test_site": "S2",
  "known_labels": [
    "AMCR",
    "AMRO",
    "BLJA",
    "ECMC",
    "ECMK",
    "ENGE",
    "FFCR",
    "RNFL"
  ],
  "unknown_labels": [
    "BAWW",
    "BCCH",
    "BUBP",
    "EAPH",
    "RBNU"
  ],
  "manifest_path": "birdosr_baseline/outputs/s1s2_birdmae_noaug_oeps_oe_high_energy/manifest.csv",
  "output_dir": "birdosr_baseline/outputs/s1s2_birdmae_noaug_final_highoe_global_score_energy_margin_proto_distance",
  "seed": 26,
  "split": {
    "train_fraction": 0.9,
    "val_fraction": 0.1,
    "unknown_val_fraction": 0.2,
    "unknown_oe_fraction": 0.5
  },
  "audio": {
    "sample_rate": 32000,
    "clip_seconds": 8.0,
    "n_mels": 128,
    "n_fft": 2048,
    "hop_length": 512,
    "frontend": "birdmae"
  },
  "augmentation": {
    "random_gain_db": 0.0,
    "time_shift_fraction": 0.0,
    "time_mask_param": 0,
    "freq_mask_param": 0,
    "background_noise_prob": 0.0,
    "background_noise_snr_db": [
      5.0,
      20.0
    ],
    "background_noise_labels": [],
    "mixup_alpha": 0.0
  },
  "model": {
    "backbone": "birdmae:models/Bird-MAE-Base",
    "pretrained": true,
    "dropout": 0.2,
    "finetune_mode": "linear_probe"
  },
  "training": {
    "epochs": 50,
    "batch_size": 16,
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "label_smoothing": 0.1,
    "class_balanced_sampler": true,
    "num_workers": 4,
    "deterministic": true,
    "oe": {
      "enabled": true,
      "split": "oe",
      "batch_size": 16,
      "energy_weight": 0.2,
      "uniform_weight": 0.1,
      "distance_weight": 0.01,
      "distance_margin": 5.0
    }
  },
  "osr": {
    "method": "learned_fusion_subset_tau",
    "scores": [
      "energy",
      "margin",
      "proto_distance"
    ],
    "msp_temperature": 1.0,
    "learned_fusion": {
      "steps": 2000,
      "learning_rate": 0.05,
      "l2": 0.001,
      "nonnegative": false
    },
    "unknown_subset_size": 3,
    "subset_tau_objective": "ACC_subset_mean",
    "subset_tau_max_candidates": 200,
    "subset_tau_passes": 2
  },
  "ablation_label": "HighEnergyScoreGlobal: learned Energy + Margin + proto_distance",
  "ablation_group": "high_oe_scoring_global_ablation",
  "osr_training": {
    "method": "protosphere",
    "prototype_loss_weight": 0.1,
    "prototype_margin": 1.0,
    "radius_loss_weight": 0.05,
    "radius_reg_weight": 0.0001,
    "radius_init": 1.0
  },
  "ablation_status": "supplement_eval_config",
  "ablation_note": "BirdOSR-Final scoring ablation: fixed High-Energy OE + ProtoSphere checkpoint, learned fusion over this score subset, subset global tau.",
  "source_checkpoint_experiment": "s1s2_birdmae_noaug_oeps_oe_high_energy"
}
